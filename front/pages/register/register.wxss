/* pages/register/register.wxss */

page {
  background: linear-gradient(180deg, #fff5f5 0%, #f0f0f5 60%);
}

.reg-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 50rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.reg-header {
  text-align: center;
  padding-top: 80rpx;
  padding-bottom: 50rpx;
}

.reg-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.reg-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

/* ===== 表单 ===== */
.form-area {
  width: 100%;
}

.input-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  height: 96rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.input-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #bbb;
}

.pwd-toggle {
  width: 38rpx;
  height: 38rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

/* ===== 协议勾选 ===== */
.terms-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 10rpx 0 20rpx;
  padding-left: 4rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #ff5252;
  border-color: #ff5252;
}

.terms-text {
  font-size: 24rpx;
  color: #999;
}

.terms-link {
  font-size: 24rpx;
  color: #666;
}

/* ===== 注册按钮 ===== */
.btn-register {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 48rpx;
  margin-top: 10rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(238, 90, 36, 0.3);
  padding: 0;
}

.btn-register[disabled] {
  opacity: 0.8;
}

/* ===== 登录入口 ===== */
.login-entry {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #999;
}

.login-link {
  color: #ff5252;
  font-weight: 500;
  margin-left: 6rpx;
}
