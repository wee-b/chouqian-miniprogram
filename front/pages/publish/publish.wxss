/* pages/publish/publish.wxss */

page { background: #f2f3f7; }

.loading-wrap {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ===== 滚动容器 ===== */
.page-scroll {
  height: 100vh;
}

/* ===== 步骤卡片 ===== */
.sec-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.03);
}

.sec-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.step-badge {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
}

.sec-extra {
  font-size: 26rpx;
  color: #ff5252;
  font-weight: 500;
}

/* ===== 字段 ===== */
.field {
  margin-bottom: 22rpx;
}

.field:last-child { margin-bottom: 0; }

.field.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}

.field-label.required::after {
  content: ' *';
  color: #f44336;
  font-size: 24rpx;
}

.field-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ebebeb;
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  background: #fafafa;
}

.field-input:focus { background: #fff; border-color: #ff5252; }

.field-input.short {
  width: 180rpx;
  margin-top: 0;
  text-align: center;
  background: #fafafa;
}

.field-area {
  width: 100%;
  min-height: 150rpx;
  border: 1rpx solid #ebebeb;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  background: #fafafa;
}

/* ===== Switch 双选 ===== */
.switch-row {
  display: flex;
  background: #f5f5f5;
  border-radius: 34rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.switch-opt {
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #999;
  transition: all 0.2s;
}

.switch-opt.on {
  background: #fff;
  color: #333;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* ===== Picker / Stepper ===== */
.picker-text {
  font-size: 28rpx;
  color: #1677ff;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1rpx solid #ebebeb;
  border-radius: 12rpx;
  overflow: hidden;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background: #f5f5f5;
}

.step-val {
  width: 80rpx;
  height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  background: #fff;
}

/* ===== 奖品列表 ===== */
.prize-item {
  display: flex;
  align-items: center;
  background: #fafafa;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.prize-rank {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.rank-1 { background: linear-gradient(135deg, #f5af19, #f12711); }
.rank-2 { background: linear-gradient(135deg, #bdc3c7, #8e9eab); }
.rank-3 { background: linear-gradient(135deg, #cd7f32, #a0522d); }
.rank-4, .rank-5, .rank-6 { background: #aaa; }

.prize-body {
  flex: 1;
}

.prize-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  display: block;
}

.prize-meta {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.prize-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.act-edit { font-size: 24rpx; color: #1677ff; }
.act-del { font-size: 24rpx; color: #f44336; }

.prize-empty {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 26rpx;
  color: #bbb;
}

/* ===== 提交按钮 ===== */
.submit-wrap {
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.submit-row {
  display: flex;
  gap: 20rpx;
}

.btn-draft,
.btn-publish {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 45rpx;
  border: none;
  padding: 0;
}

.btn-draft {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.btn-publish {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(238,90,36,0.25);
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border-radius: 45rpx;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(238,90,36,0.25);
}

/* ===== 封面选择器 ===== */
.cover-picker {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-top: 10rpx;
  background: #f0f0f0;
}

.cover-picker.small {
  height: 200rpx;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.35);
  padding: 14rpx 0;
  text-align: center;
}

.cover-mask text {
  color: #fff;
  font-size: 24rpx;
}

/* ===== 奖品编辑底栏 ===== */
.pf-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
}

.pf-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 36rpx 30rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 201;
  max-height: 80vh;
  overflow-y: auto;
}

.pf-head {
  text-align: center;
  margin-bottom: 28rpx;
}

.pf-title { font-size: 34rpx; font-weight: 700; }

.pf-field { margin-bottom: 22rpx; }

.pf-label {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 8rpx;
}

.pf-input {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid #ebebeb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.pf-input.short { width: 160rpx; }

.stepper-row {
  display: flex;
  align-items: center;
  border: 1rpx solid #ebebeb;
  border-radius: 12rpx;
  overflow: hidden;
  width: fit-content;
}

.stepper-row .step-btn {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  font-weight: 600;
}

.stepper-text {
  width: 160rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.pf-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-pf {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 41rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
}

.btn-pf.cancel { background: #f5f5f5; color: #666; }
.btn-pf.confirm { background: linear-gradient(135deg, #ff6b6b, #ee5a24); color: #fff; }
