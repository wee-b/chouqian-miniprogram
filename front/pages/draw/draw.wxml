<!--pages/draw/draw.wxml-->
<view class="draw-page">
  <!-- 顶部说明 -->
  <view class="page-header">
    <text class="page-title">口令参与</text>
    <text class="page-desc">输入抽签口令，快速参与活动</text>
  </view>

  <!-- 口令输入区 -->
  <view class="search-box">
    <input
      class="code-input"
      type="number"
      maxlength="6"
      placeholder="输入6位口令"
      value="{{passCode}}"
      bindinput="onPassCodeInput"
      focus="{{true}}"
    />
    <view class="search-actions">
      <view class="btn-scan" bindtap="handleScan">
        <text>扫码</text>
      </view>
      <button class="btn-search" bindtap="handleSearch" loading="{{searching}}">查询</button>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="result-area" wx:if="{{searched}}">
    <block wx:if="{{searchResult}}">
      <view class="result-card" bindtap="goToResult">
        <image class="result-cover" src="{{searchResult.drawCover || '/images/default-draw.png'}}" mode="aspectFill" />
        <view class="result-info">
          <text class="result-title">{{searchResult.title}}</text>
          <view class="result-btn">立即参与 ></view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-result">
        <text>未找到对应抽签</text>
        <text class="empty-hint">请检查口令是否正确或是否已失效</text>
      </view>
    </block>
  </view>

  <!-- 提示信息 -->
  <view class="tips-section">
    <view class="tips-title">使用说明</view>
    <view class="tips-list">
      <text>1. 向活动发起者获取6位数字口令</text>
      <text>2. 输入口令查询对应抽签活动</text>
      <text>3. 点击查询结果进入活动详情页</text>
      <text>4. 在详情页点击"立即参与"即可加入</text>
    </view>
  </view>
</view>
