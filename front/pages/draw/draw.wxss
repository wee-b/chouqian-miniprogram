/* pages/draw/draw.wxss */
page {
  background: #f5f5f5;
}

.draw-page {
  padding: 0 30rpx;
  min-height: 100vh;
}

/* 顶部 */
.page-header {
  text-align: center;
  padding: 50rpx 0 40rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.page-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 搜索区 */
.search-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  margin-bottom: 30rpx;
}

.code-input {
  width: 100%;
  height: 90rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  text-align: center;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.code-input:focus {
  border-color: #1677ff;
}

.search-actions {
  display: flex;
  gap: 20rpx;
}

.btn-scan {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 40rpx;
}

.btn-search {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #ff7a7a, #ff5252);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
  text-align: center;
  padding: 0;
}

/* 搜索结果 */
.result-area {
  margin-bottom: 30rpx;
}

.result-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.result-cover {
  width: 46%;
  height: 260rpx;
  flex-shrink: 0;
  background: #f1f1f1;
}

.result-info {
  flex: 1;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.5;
}

.result-btn {
  font-size: 28rpx;
  color: #ff5252;
  font-weight: 500;
}

.empty-result {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  display: block;
  margin-top: 10rpx;
}

/* 使用说明 */
.tips-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-list text {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 2;
}
