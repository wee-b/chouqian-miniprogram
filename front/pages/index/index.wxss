/* pages/index/index.wxss */

/* ===== 基础 ===== */
page {
  background: #f6f7fa;
  font-size: 28rpx;
}

/* ===== 状态栏 ===== */
.status-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  transition: background 0.25s ease;
}

/* ===== 导航栏 ===== */
.navbar {
  position: fixed;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  z-index: 1000;
  transition: background 0.25s ease;
}

.nav-btns {
  display: flex;
  gap: 16rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.nav-btns-show {
  opacity: 1;
  pointer-events: auto;
}

.nav-btn {
  padding: 10rpx 28rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #333;
}

/* ===== 滚动容器 ===== */
.page-scroll {
  height: 100vh;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  margin: 10rpx 25rpx 0;
  padding: 50rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #ff6b6b 0%, #ee5a24 40%, #f093fb 100%);
  overflow: hidden;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  letter-spacing: 2rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 装饰圆 */
.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}

.hero-circle.c1 {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.hero-circle.c2 {
  width: 120rpx;
  height: 120rpx;
  bottom: -30rpx;
  right: 60rpx;
}

/* ===== 轮播图 ===== */
.banner-section {
  margin: 28rpx 25rpx 0;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 16rpx;
}

.banner-wrap {
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
}

.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  background: #e8e8e8;
}

.banner-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ===== 快捷入口 ===== */
.quick-bar {
  display: flex;
  margin: -30rpx 45rpx 0;
  position: relative;
  z-index: 3;
}

.quick-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  padding: 24rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.quick-item:first-child {
  margin-right: 20rpx;
}

.quick-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 10rpx;
}

.quick-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* ===== 区块头 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 40rpx 30rpx 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-count {
  font-size: 24rpx;
  color: #aaa;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 0 25rpx;
}

.skeleton-card {
  display: flex;
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.sk-img {
  width: 50%;
  height: 320rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.sk-info {
  width: 50%;
  padding: 35rpx 25rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sk-line {
  height: 24rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

.sk-line.w80 { width: 80%; }
.sk-line.w50 { width: 50%; }
.sk-line.w30 { width: 30%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-wrap {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #888;
  display: block;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #bbb;
  display: block;
}

/* ===== 卡片列表 ===== */
.card-list {
  padding: 0 25rpx;
}

.draw-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  transition: transform 0.2s ease;
}

.draw-card:active {
  transform: scale(0.97);
}

.card-img-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.card-img {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
}

.card-badge {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  background: rgba(0,0,0,0.45);
  padding: 6rpx 16rpx 6rpx 6rpx;
  border-radius: 40rpx;
  backdrop-filter: blur(10rpx);
}

.badge-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #ddd;
}

.card-badge text {
  font-size: 22rpx;
  color: #fff;
}

.card-body {
  padding: 24rpx 28rpx 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.card-meta {
  margin-bottom: 14rpx;
}

.meta-participants {
  font-size: 24rpx;
  color: #999;
}

.card-action {
  display: flex;
  justify-content: flex-end;
}

.card-btn {
  display: inline-block;
  padding: 12rpx 36rpx;
  background: linear-gradient(135deg, #ff7a7a, #ff5252);
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 底部 ===== */
.bottom-safe {
  width: 100%;
}
