page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  padding: 24rpx 0;
  position: relative;
}

.tab-active {
  color: #1677ff;
  font-weight: 500;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #1677ff;
  border-radius: 2rpx;
}

/* 列表 */
.list-wrap {
  flex: 1;
  padding: 20rpx;
}

.draw-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.draw-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.draw-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.draw-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.draw-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.s0 { background: #f5f5f5; color: #999; }
.s1 { background: #e6f7ff; color: #1677ff; }
.s2 { background: #f6ffed; color: #52c41a; }
.s3 { background: #fff2f0; color: #ff4d4f; }

.arrow-right {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}
