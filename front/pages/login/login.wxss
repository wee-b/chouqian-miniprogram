/* pages/login/login.wxss */

page {
  background: linear-gradient(180deg, #fff5f5 0%, #f0f0f5 60%);
}

.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 50rpx;
  box-sizing: border-box;
}

/* ===== 品牌区 ===== */
.brand-area {
  text-align: center;
  padding-top: 100rpx;
  padding-bottom: 50rpx;
}

.brand-logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(255, 82, 82, 0.15);
}

.brand-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-top: 24rpx;
  letter-spacing: 4rpx;
}

.brand-slogan {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

/* ===== 表单 ===== */
.form-area {
  width: 100%;
}

.input-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  height: 100rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #bbb;
}

.pwd-toggle {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

/* ===== 登录按钮 ===== */
.btn-login {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 48rpx;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(238, 90, 36, 0.3);
  padding: 0;
}

.btn-login[disabled] {
  opacity: 0.8;
}

/* ===== 其他登录方式 ===== */
.other-login {
  margin-top: 60rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 28rpx;
  font-size: 24rpx;
  color: #b0b0b0;
}

.other-icons {
  display: flex;
  justify-content: center;
  gap: 80rpx;
}

.other-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.other-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  padding: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.other-item text {
  font-size: 22rpx;
  color: #999;
}

/* ===== 注册入口 ===== */
.reg-entry {
  text-align: center;
  margin-top: 50rpx;
  font-size: 26rpx;
  color: #999;
}

.reg-link {
  color: #ff5252;
  font-weight: 500;
  margin-left: 6rpx;
}

/* ===== 底部协议 ===== */
.footer-tip {
  position: fixed;
  bottom: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}

.footer-link {
  color: #888;
}
