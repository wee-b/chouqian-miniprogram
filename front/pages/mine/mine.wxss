page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.mine-container {
  padding: 20rpx;
}

/* 1. 个人信息卡片 */
.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-text .nickname-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.level-tag {
  background: #ffb300;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
}

.tip {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.wish-entry {
  display: flex;
  align-items: center;
  color: #cc7722;
  font-size: 28rpx;
}

.red-dot {
  width: 10rpx;
  height: 10rpx;
  background: #ff4d4f;
  border-radius: 50%;
  margin-right: 8rpx;
}

.arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
}

/* 2. 数据统计区 */
.stats-wrap {
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

/* 3. 活动 Banner */
.banner-wrap {
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.banner-title {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.banner-desc {
  display: block;
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 30rpx;
}

.banner-btn {
  display: inline-block;
  background: #fff;
  color: #ff9a9e;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
}

/* 4. 功能图标区 */
.func-grid {
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.func-grid.second-line {
  margin-bottom: 60rpx;
}

.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.func-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.func-name {
  font-size: 26rpx;
  color: #666;
}

/* 5. 底部版权信息 */
.copyright {
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.copyright .desc {
  display: block;
  margin-top: 8rpx;
}

/* 未登录 点击登录文字 */
.login-txt {
  font-size: 32rpx;
  color: #666;
}