/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 

.global-notify-toast {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  z-index: 9999;
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 18rpx 22rpx 18rpx 18rpx;
  background: rgba(252, 253, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 30rpx;
  box-shadow: 0 20rpx 52rpx rgba(15, 23, 42, 0.22);
  transform: translateY(-150%);
  opacity: 0;
  transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  box-sizing: border-box;
  pointer-events: none;
  overflow: hidden;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.global-notify-toast.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.global-notify-badge {
  width: 74rpx;
  height: 74rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1677ff 0%, #20c997 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.28);
}

.global-notify-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.global-notify-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #111827;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.global-notify-content {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5f6b7a;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
